APP_NAME=VoiceInspect
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./data/db/voiceinspect.db
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=quentinz/bge-large-zh-v1.5:latest
OLLAMA_VISION_MODEL=
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_NUM_THREADS=4
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_BATCH=128
OLLAMA_LLM_NUM_PREDICT=512
OLLAMA_VISION_NUM_CTX=4096
OLLAMA_VISION_NUM_BATCH=64
OLLAMA_VISION_NUM_PREDICT=256
VISION_IMAGE_MAX_SIZE=1024
VISION_ANOMALY_SECOND_PASS=false
STT_MODEL_SIZE=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_MODEL_PATH=
MAX_AUDIO_SECONDS=120
MAX_IMAGE_PIXELS=20000000
CONFIRMATION_TTL_SECONDS=600
UPLOAD_DIR=./data/uploads
KNOWLEDGE_DIR=./data/knowledge
LOG_DIR=./data/logs
MAX_UPLOAD_BYTES=10485760
ACCESS_TOKEN_MINUTES=720
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DEMO_OPERATOR_USERNAME=operator
DEMO_OPERATOR_PASSWORD=change-me
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=change-me-admin
DEMO_SUPERVISOR_USERNAME=supervisor
DEMO_SUPERVISOR_PASSWORD=change-me-supervisor
DEMO_KNOWLEDGE_ADMIN_USERNAME=knowledge-admin
DEMO_KNOWLEDGE_ADMIN_PASSWORD=change-me-knowledge

PIPER_EXECUTABLE=piper
PIPER_VOICE=

# Authentication hardening
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=60
MAX_ACTIVE_SESSIONS_PER_USER=5
AUTO_CREATE_SCHEMA=true
SEED_DEMO_DATA=true
